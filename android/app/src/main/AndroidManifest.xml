<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- to notice the AirPods connecting to this phone (hand-off with the laptop) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- read the AirPods' battery broadcast on the phone itself (no location use) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <!-- source-side EQ: audiofx effects held by a foreground service -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="Headphones"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">

        <!-- The app screen: pick your AirPods, optional laptop panel URL. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ACL connect/disconnect are exempt from the implicit-broadcast ban -->
        <receiver
            android:name=".BtReceiver"
            android:exported="true"
            android:permission="android.permission.BLUETOOTH_CONNECT">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- keeps the EQ effects alive while the app isn't on screen -->
        <service
            android:name=".EqService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's audio equalizer attached to the phone's audio output" />
        </service>

        <receiver
            android:name=".HeadphonesWidget"
            android:exported="true"
            android:label="Headphones">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/headphones_widget_info" />
        </receiver>
    </application>
</manifest>
