<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- to notice the AirPods connecting to this phone (hand-off with the laptop) -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- read the AirPods' battery broadcast on the phone itself (no location use) -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation" />
    <!-- source-side EQ: audiofx effects held by a foreground service -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Ear detection: one quiet link to the AirPods while they are connected (a "connected device" service) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Smart adaptive: "are you walking" from the phone's motion sensors (asked when you turn it on) -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- optional sub-option only (call -> transparency); requested at runtime only if you turn it on -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Live Translation: the AirPods' mics (only while you have it on), as a microphone foreground service -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Filtered hearing: plays the cleaned room sound to the AirPods with the screen off (only while it is on) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Last seen (optional, asked on the Last seen screen): the phone's location when headphones disconnect,
         stored on the phone only. Background location only if you choose "Allow all the time". -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <!-- the finder's "closer = faster" buzz; the map's tile cache checks for a network -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- package visibility: the phone's speech recognizer and text-to-speech engine -->
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
    </queries>

    <application
        android:label="Headphones"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">

        <!-- The app screen: pick your AirPods, optional laptop panel URL. -->
        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Live Translation screen (the widget's Translate button opens it with a toggle) -->
        <activity
            android:name=".TranslateActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- What your AirPods hear: their own mics over AAP (no call mode), only while this screen is open -->
        <activity
            android:name=".ListenActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- Filtered hearing benchmark: no launcher entry; only the shell (adb, which holds DUMP) can open it.
             Synthetic audio in memory; plays nothing. -->
        <activity
            android:name=".BenchActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- Filtered hearing: keeps the AirPods' mic stream and the playback going with the screen off -->
        <service
            android:name=".HearingService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Packets: the Bluetooth bytes this app sends and reads, decoded and masked, in memory only -->
        <activity
            android:name=".PacketsActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- Last seen: map, history, permissions -->
        <activity
            android:name=".TrackActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- Hotter / colder finder (scans only while open) -->
        <activity
            android:name=".FinderActivity"
            android:exported="false"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />

        <!-- A few seconds of location right after a disconnect, then it stops itself -->
        <service
            android:name=".LocateService"
            android:exported="false"
            android:foregroundServiceType="location|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Saves when headphones disconnected, for the user's own Last seen history on the phone" />
        </service>

        <!-- Live Translation: holds the AirPods' mic (Bluetooth SCO) while a session runs -->
        <service
            android:name=".LiveTranslateService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Crusher Adaptive: the phone's mic (or, if chosen, the Crusher's) hears the room only while it is on -->
        <service
            android:name=".CrusherAdaptiveService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- No analytics: ML Kit ships Google's event-logging backend (Firebase "CCT" transport). Removing
             its registration means the transport has no backend and drops those events on the phone. -->
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
                tools:node="remove" />
        </service>

        <!-- ACL connect/disconnect are exempt from the implicit-broadcast ban -->
        <receiver
            android:name=".BtReceiver"
            android:exported="true"
            android:permission="android.permission.BLUETOOTH_CONNECT">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <!-- Ear detection: holds the AirPods' AAP link while they're on this phone, for their in-ear reports -->
        <service
            android:name=".EarService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- keeps the EQ effects alive while the app isn't on screen -->
        <service
            android:name=".EqService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user's audio equalizer attached to the phone's audio output" />
        </service>

        <!-- Smart adaptive: activity changes, hold timer, boot, call state; boot/update also restart the EQ -->
        <receiver android:name=".SmartReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".HeadphonesWidget"
            android:exported="true"
            android:label="Headphones">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/headphones_widget_info" />
        </receiver>
    </application>
</manifest>
